# ---------- Stage 1: Build ----------
FROM node:20-alpine AS builder

# 1. Cài ffmpeg trước (Alpine dùng apk)
RUN apk add --no-cache ffmpeg

# 2. Enable pnpm
RUN corepack enable
WORKDIR /app

# 3. Build args
# ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL
# ARG NEXT_PUBLIC_ADMIN_URL
# ARG NEXT_PUBLIC_ENABLE_FULLSCREEN
# ARG NEXT_PUBLIC_ENABLE_TAB_DETECTION
# ARG NEXT_PUBLIC_ENABLE_MOUSE_TRACKING
# ARG NEXT_PUBLIC_ENABLE_KEYBOARD_BLOCK
# ARG NEXT_PUBLIC_ENABLE_CAMERA
# ARG NEXT_PUBLIC_QUIZ_TIME_LIMIT
# ARG NEXT_PUBLIC_MAX_VIOLATIONS
# ARG NEXT_PUBLIC_PASSING_SCORE
# ARG NEXT_PUBLIC_MOUSE_OUT_DELAY
# ARG VIDEO_SECRET_KEY

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL 
    # NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    # NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    # NEXT_PUBLIC_ENABLE_FULLSCREEN=$NEXT_PUBLIC_ENABLE_FULLSCREEN \
    # NEXT_PUBLIC_ENABLE_TAB_DETECTION=$NEXT_PUBLIC_ENABLE_TAB_DETECTION \
    # NEXT_PUBLIC_ENABLE_MOUSE_TRACKING=$NEXT_PUBLIC_ENABLE_MOUSE_TRACKING \
    # NEXT_PUBLIC_ENABLE_KEYBOARD_BLOCK=$NEXT_PUBLIC_ENABLE_KEYBOARD_BLOCK \
    # NEXT_PUBLIC_ENABLE_CAMERA=$NEXT_PUBLIC_ENABLE_CAMERA \
    # NEXT_PUBLIC_QUIZ_TIME_LIMIT=$NEXT_PUBLIC_QUIZ_TIME_LIMIT \
    # NEXT_PUBLIC_MAX_VIOLATIONS=$NEXT_PUBLIC_MAX_VIOLATIONS \
    # NEXT_PUBLIC_PASSING_SCORE=$NEXT_PUBLIC_PASSING_SCORE \
    # NEXT_PUBLIC_MOUSE_OUT_DELAY=$NEXT_PUBLIC_MOUSE_OUT_DELAY \
    # VIDEO_SECRET_KEY=$VIDEO_SECRET_KEY

# 4. Install deps & build
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

# ---------- Stage 2: Runtime ----------
FROM node:20-alpine AS runner

# Cài ffmpeg cho runtime (nếu dev & prod khác container)
RUN apk add --no-cache ffmpeg

WORKDIR /app
ENV NODE_ENV=production

# Copy standalone output
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3012
CMD ["node", "server.js"]