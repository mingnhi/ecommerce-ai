# ============================================================================
# E-COMMERCE BACKEND — ENV TEMPLATE
# ============================================================================
# Copy file này thành `.env` và điền giá trị thật cho local dev.
# Các biến đánh dấu [S1]/[S6] là module/sprint khác sẽ cần — Phong (S3-S5)
# chỉ bắt buộc các biến trong nhóm "App" và "Database".
# ============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3003

# --- Database (MySQL) --------------------------------------------------------
# Khớp với @mikro-orm/mysql + mikro-orm.config.ts
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=ecommerce_dev

# --- JWT [S1 — Nhi] ----------------------------------------------------------
# Sinh secret tối thiểu 32 ký tự, vd:  openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-32+char-random-hex
JWT_REFRESH_SECRET=replace-with-different-32+char-random-hex
JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# --- Redis cache [S1-08 — Nhi] -----------------------------------------------
# Bật khi RBAC permission cache cần thiết
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Mail (SMTP — nodemailer) ------------------------------------------------
# Wire để forgot password / order confirmation / verify email gửi thật.
# Nếu KHÔNG set SMTP_HOST/USER/PASSWORD → MailerService log content ra console (dev OK).
#
# Dev khuyên dùng Mailtrap (https://mailtrap.io) — free fake inbox:
#   Mailtrap dashboard → Sandbox → SMTP Settings → copy credentials
# Prod: Resend (https://resend.com/smtp), SendGrid, Amazon SES, ...
#
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com

# --- File / Image upload [S2-05 — Tiến] --------------------------------------
# UPLOAD_MAX_SIZE_MB=5
# CDN_BASE_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- PayPal [S6-01] ----------------------------------------------------------
# Đăng ký https://developer.paypal.com → My Apps → Create app (Sandbox).
# Copy Client ID + Secret vào đây. WEBHOOK_ID lấy từ Webhooks tab khi tạo webhook.
# --- Google OAuth (BE verify access_token) -----------------------------------
# Khi user click "Login with Google" trên FE, NextAuth lấy access_token,
# gửi sang BE `POST /auth/google` → BE fetch userinfo từ Google → tạo/login user.
# GOOGLE_CLIENT_ID không bắt buộc (current code không verify aud claim),
# nhưng FE NextAuth cần CLIENT_ID/SECRET trong frontend/.env.local.
# GOOGLE_CLIENT_ID=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
VND_TO_USD_RATE=25000
FRONTEND_URL=http://localhost:3000

# --- AI Chatbot (Phase 8A) --------------------------------------------------
# Lấy API key tại https://console.anthropic.com
# Nếu KHÔNG set, endpoint /ai/chat sẽ trả 503 (chatbot hiển thị message lỗi
# graceful, không crash). Set để kích hoạt chat tư vấn AI.
ANTHROPIC_API_KEY=
# Default: claude-haiku-4-5 (rẻ + nhanh, đủ cho chat tư vấn).
# Có thể đổi sang claude-sonnet-4-6 hoặc claude-opus-4-7 nếu cần intelligence cao hơn.
AI_MODEL=claude-haiku-4-5

# --- Inventory / Cart / Order [S3-S5 — Phong] -------------------------------
# Hiện chưa wire env nào — defaults hard-coded trong entity/DTO:
#   - Inventory.lowStockThreshold = 10  (per-record, override khi tạo)
#   - CartItem max quantity = 999       (DTO @Max)
#   - mergeCarts maxQuantity = 999      (default option)
# Nếu sau này cần config env, sẽ thêm vào đây.
